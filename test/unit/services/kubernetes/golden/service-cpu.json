{
  "kubernetesDeployment": {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "annotations": {
        "anycloud.sh/deployment-id": "svc-a",
        "anycloud.sh/owner-api": "00000000000000000000000000000001",
        "anycloud.sh/user-id": "alice"
      },
      "labels": {
        "anycloud.sh/deployment-hash": "645fcba02891a65e",
        "app.kubernetes.io/component": "kubernetes-serve",
        "app.kubernetes.io/managed-by": "anycloud"
      },
      "name": "anycloud-serve-svc-a-645fcba028",
      "namespace": "anycloud-serve-svc-a-645fcba028"
    },
    "spec": {
      "minReadySeconds": 30,
      "replicas": 1,
      "revisionHistoryLimit": 1,
      "selector": {
        "matchLabels": {
          "anycloud.sh/deployment-hash": "645fcba02891a65e",
          "app.kubernetes.io/component": "kubernetes-serve",
          "app.kubernetes.io/managed-by": "anycloud"
        }
      },
      "strategy": {
        "type": "Recreate"
      },
      "template": {
        "metadata": {
          "annotations": {
            "anycloud.sh/deployment-id": "svc-a",
            "anycloud.sh/owner-api": "00000000000000000000000000000001",
            "anycloud.sh/user-id": "alice"
          },
          "labels": {
            "anycloud.sh/deployment-hash": "645fcba02891a65e",
            "app.kubernetes.io/component": "kubernetes-serve",
            "app.kubernetes.io/managed-by": "anycloud"
          }
        },
        "spec": {
          "affinity": {
            "nodeAffinity": {
              "requiredDuringSchedulingIgnoredDuringExecution": {
                "nodeSelectorTerms": [
                  {
                    "matchExpressions": [
                      {
                        "key": "node-restriction.kubernetes.io/anycloud-node-pool",
                        "operator": "In",
                        "values": [
                          "node-pool-a"
                        ]
                      },
                      {
                        "key": "anycloud.sh/cluster",
                        "operator": "In",
                        "values": [
                          "cluster-a"
                        ]
                      }
                    ]
                  }
                ]
              }
            }
          },
          "automountServiceAccountToken": false,
          "containers": [
            {
              "env": [
                {
                  "name": "WORKLOAD_ID",
                  "value": "svc-a"
                },
                {
                  "name": "DEPLOYMENT_ID",
                  "value": "svc-a"
                },
                {
                  "name": "PORT",
                  "value": "8088"
                }
              ],
              "image": "example/api:v1",
              "name": "workload",
              "ports": [
                {
                  "containerPort": 8088,
                  "name": "http"
                }
              ],
              "readinessProbe": {
                "periodSeconds": 5,
                "tcpSocket": {
                  "port": 8088
                }
              },
              "startupProbe": {
                "failureThreshold": 120,
                "periodSeconds": 5,
                "tcpSocket": {
                  "port": 8088
                }
              }
            }
          ],
          "dnsPolicy": "Default",
          "nodeSelector": {
            "anycloud.sh/ingress-entry": "node-pool-a",
            "node-restriction.kubernetes.io/anycloud-node-pool": "node-pool-a"
          },
          "restartPolicy": "Always",
          "tolerations": [
            {
              "effect": "NoSchedule",
              "key": "anycloud.sh/node-pool",
              "operator": "Equal",
              "value": "node-pool-a"
            }
          ]
        }
      }
    }
  },
  "secrets": []
}
