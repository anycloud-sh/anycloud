                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991,
                        "exclusiveMinimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "state": {
                    "enum": [
                      "queued",
                      "provisioning",
                      "initializing",
                      "downloading",
                      "starting",
                      "syncing",
                      "retrying",
                      "recovering",
                      "running",
                      "finalizing",
                      "completed",
                      "failed",
                      "errored",
                      "invalid",
                      "terminated"
