                  }
                ],
                "discriminator": {
                  "propertyName": "code",
                  "mapping": {
                    "WORKLOAD_UNAUTHORIZED": "#/components/schemas/WorkloadUnauthorizedApiError"
                  }
                }
              }
            }
          }
        },
