{
  "name": "anycloud",
  "private": true,
  "version": "0.1.85",
  "previousVersion": "0.1.84",
  "description": "Deploy containerized jobs to any cloud provider",
  "apiImage": "ghcr.io/anycloud-sh/api",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22 || ^24 || >=26"
  },
  "scripts": {
    "build": "yarn clean && tsc && yarn build:check",
    "build:check": "CIPHER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef node --eval \"import('./dist/api/server.js').catch(e => { console.error(e.message); process.exit(1); })\"",
    "build:binaries": "bash release/build-binaries.sh",
    "build:docs": "cd website && npm ci && npm run build",
    "clean": "rm -rf dist",
    "cli": "node ./dist/cli/index.js",
    "cli:dev": "API_URL=http://localhost:8081 node ./dist/cli/index.js",
    "cli:prod": "node ./dist/cli/index.js",
    "seed": "tsx ci/seed.ts",
    "local-runtime:setup": "tsx scripts/ci/setup-local-smolvm-runtime.ts",
    "local-runtime:cleanup": "tsx scripts/ci/cleanup-local-smolvm-runtime.ts",
    "start:api": "node ./dist/api/server.js",
    "api:dev": "bash scripts/api-dev.sh",
    "api:dev:stop": "bash scripts/api-dev.sh stop",
    "test": "vitest run --exclude '**/test/integration/**' --fileParallelism --maxWorkers=4 --silent=passed-only",
    "test:mutation:harness": "node test/mutation/run-harness.mjs",
    "test:mutation:src-parity": "node test/mutant-parity/src-parity.mjs",
