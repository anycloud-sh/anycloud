        "requestedGeneration",
        "appliedGeneration",
        "podGeneration",
        "podName",
        "podUid",
        "containerId",
        "containerReady",
        "readyReplicas",
        "applicationReady",
        "probeConfigured",
        "observation",
        "observedAt",
        "observationError",
        "blockingJobs"
