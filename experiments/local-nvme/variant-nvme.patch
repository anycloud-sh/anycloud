+/**
+ * The local-nvme experiment's disk: an AWS instance store or GCP local SSD,
+ * formatted at boot and mounted at LOCAL_DISK_MOUNT, with the image stores
+ * and /workspace bound onto it as on Azure's resource disk. A Job host
+ * without one keeps them on the OS disk.
+ */
+const LOCAL_DISK_MOUNT = '/mnt/local';
+const LOCAL_DISK = `local_disk() {
+  dev=
+  for b in /sys/block/nvme*n1; do
+    read -r m < "$b/device/model" || continue
+    case $m in "Amazon EC2 NVMe Instance Storage"|nvme_card) dev=/dev/\${b##*/}; break ;; esac
+  done
+  [ -n "$dev" ] || { [ -e /dev/disk/by-id/google-local-nvme-ssd-0 ] && dev=$(readlink -f /dev/disk/by-id/google-local-nvme-ssd-0); }
+  lsblk -o NAME,MODEL,SIZE,MOUNTPOINT
+  [ -n "$dev" ] || { echo "no local NVMe disk"; return 0; }
+  ${bootMark('local-disk-start')}
+  blkid "$dev" >/dev/null || mkfs.ext4 -q -E nodiscard,lazy_itable_init=1,lazy_journal_init=1 "$dev" || return 1
+  mkdir -p ${LOCAL_DISK_MOUNT} && { mountpoint -q ${LOCAL_DISK_MOUNT} || mount -o noatime "$dev" ${LOCAL_DISK_MOUNT}; } || return 1
+  (
+${resourceDiskStoreInstallCommand(LOCAL_DISK_MOUNT)}
+) && ${bootMark('local-disk-ready')}
+}`;
+
