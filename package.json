    "check:docs": "node scripts/check-canonical-docs.mjs",
    "check:mutation-scope": "node scripts/check-mutation-scope.mjs",
    "check:graph": "depcruise --config .dependency-cruiser.cjs src scripts test/integration/local-smolvm-runtime.spec.ts test/integration/e2e/internal/read-models/history-child.ts",
    "check:policy": "node scripts/check-eslint-directives.mjs",
    "check:service-terminology": "node scripts/check-service-terminology.mjs",
    "check:rfc-ledgers": "node scripts/validate-rfc-ledgers.mjs",
    "check:catalog-test-boundaries": "node scripts/check-catalog-test-boundaries.mjs",
    "test:watch": "vitest",
    "test:fail-assert": "bash test/integration/helpers/test-fail-assert.sh",
    "test:api-http-reconciliation": "bash test/integration/helpers/test-api-http-reconciliation.sh",
    "test:local-smolvm:runtime": "vitest run test/integration/local-smolvm-runtime.spec.ts --maxWorkers=1",
    "test:local-held-job:vitest": "bash test/integration/e2e.sh local-held-job --vitest",
    "test:local-completed-job:vitest": "bash test/integration/e2e.sh local-completed-job --vitest",
    "test:local-resubmitted-job:vitest": "bash test/integration/e2e.sh local-resubmitted-job --vitest",
    "test:ssh-keepalive": "vitest run test/integration/ssh-keepalive.spec.ts",
    "test:ssh-starvation": "vitest run test/integration/ssh-starvation.spec.ts",
    "test:ssh-interrupt": "vitest run test/integration/ssh-interrupt.spec.ts",
    "test:ssh-interrupt-container": "vitest run test/integration/ssh-interrupt-container.spec.ts",
