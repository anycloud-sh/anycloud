# syntax=docker/dockerfile:1

# Realistic GPU/ML test image for e2e integration tests. Keep the runtime
# payload representative, but do not ship build/download debris: this image is
# also the full-pull control for the cold-start benchmark, so every unnecessary
# byte directly delays first inference in both legs.

FROM mirror.gcr.io/nvidia/cuda:12.4.1-runtime-ubuntu22.04@sha256:517da2300c184c9999ec203c2665244bdebd3578d12fcc7065e83667932643d9

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    python3 \
    python3-dev \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.mace.txt ./

# BuildKit's cache mount makes repeat builds fast without copying pip's wheel
# and HTTP cache into the image. Keep Python bytecode warm for the import-heavy
# first-inference path, but remove static archives that are not used at runtime.
RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m pip install --upgrade pip==26.1.2 && \
    python3 -m pip install --requirement requirements.mace.txt && \
    find /usr/local/lib/python3* -name '*.a' -delete

# Pre-cache the MACE-OFF23 medium model so no network access is needed at
# runtime. This cache is intentionally part of the image, unlike pip's cache.
RUN python3 -c "from mace.calculators import mace_off; mace_off(model='medium', device='cpu')"

COPY run.py ./

# Default: run the energy calculation with a long pause so the container
# stays alive for tests that need docker exec.
CMD ["python3", "run.py", "--pause", "9999"]
