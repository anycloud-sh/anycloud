{
  "title": "Anycloud CI",
  "description": "What CI's own harness, cluster seed and catalog do with CI's GCP account beyond the published Anycloud role (src/shared/cloud-policies/gcp-anycloud-role.json); ci/gcp-roles.ts applies both. Its compute.images, compute.disks.useReadOnly, compute.networks.list and artifactregistry permissions are experiments/image-delivery's and go when that experiment is deleted.",
  "stage": "GA",
  "includedPermissions": [
    "artifactregistry.repositories.create",
    "artifactregistry.repositories.delete",
    "artifactregistry.repositories.downloadArtifacts",
    "artifactregistry.repositories.get",
    "artifactregistry.repositories.list",
    "artifactregistry.repositories.uploadArtifacts",
    "compute.disks.get",
    "compute.disks.useReadOnly",
    "compute.firewalls.get",
    "compute.firewalls.update",
    "compute.images.create",
    "compute.images.delete",
    "compute.images.get",
    "compute.images.list",
    "compute.images.setLabels",
    "compute.images.useReadOnly",
    "compute.instances.getSerialPortOutput",
    "compute.instances.setServiceAccount",
    "compute.instances.stop",
    "compute.machineTypes.list",
    "compute.networks.list",
    "compute.regions.get",
    "serviceusage.services.list",
    "storage.buckets.getIamPolicy",
    "storage.buckets.setIamPolicy"
  ]
}
