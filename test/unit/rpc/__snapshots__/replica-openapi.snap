        "Deployment Workload"
      ],
      "parameters": [
        {
          "name": "deploymentId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "name": "waitMs",
          "in": "query",
          "schema": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20000,
            "default": 0
          },
          "allowEmptyValue": true,
          "allowReserved": true
        }
      ],
      "responses": {
        "200": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkloadJobCandidate"
              }
            }
          }
        },
        "204": {},
        "400": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/ClientVersionMismatchApiError"
                  },
                  {
                    "$ref": "#/components/schemas/UndefinedApiError"
                  }
                ],
                "discriminator": {
                  "propertyName": "code",
                  "mapping": {
                    "CLIENT_VERSION_MISMATCH": "#/components/schemas/ClientVersionMismatchApiError"
                  }
                }
              }
            }
          }
        },
