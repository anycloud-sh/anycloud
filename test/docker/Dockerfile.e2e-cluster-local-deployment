# The e2e-cluster-local E2E member builds this image from the SDK under test.
# The e2e-cluster-cloud hosted stage pushes it and runs it with E2E_COMPLETE_JOB_IDS
# instead of a reservation store; on a GPU pool it builds on the cached-model
# MACE image (BASE_IMAGE) with WORKLOAD_PROFILE=mace-cuda, which makes the CPU
# references here. The harness then selects the profile through the
# Deployment's E2E_WORKLOAD_PROFILE, and every Job runs a checked CUDA energy.
# With WORKLOAD_PROFILE=voice it builds on test/docker/Dockerfile.voice and
# renders the voice reference on CPU here, which Whisper must hear as its text.
ARG BASE_IMAGE=mirror.gcr.io/library/python:3.12-slim@sha256:f77ac9e44ae96ef2c90b8053ea08c31f8be030f824196b0ae4db6d462c84e51f
FROM ${BASE_IMAGE}

ARG ANYCLOUD_SDK_WHEEL_DIR
ARG WORKLOAD_PROFILE=
# The local member's pool Jobs clone a private repo through `--secret`.
RUN if [ -z "$WORKLOAD_PROFILE" ]; then \
      apt-get update && apt-get install -y --no-install-recommends git \
      && rm -rf /var/lib/apt/lists/*; fi
COPY ${ANYCLOUD_SDK_WHEEL_DIR}/*.whl /sdk/
RUN test "$(find /sdk -maxdepth 1 -name '*.whl' | wc -l)" -eq 1 \
    && python3 -m pip install --no-cache-dir /sdk/*.whl \
    && rm -rf /sdk

# Pool Jobs restore their working directory between Jobs (0044/S19).
WORKDIR /app
COPY test/integration/e2e/internal/fixtures/deployment.py /app/deployment.py
COPY test/integration/e2e/internal/fixtures/mace_inference.py /app/mace_inference.py
COPY test/integration/e2e/internal/fixtures/voice_session.py /app/voice_session.py
# CPU references come from the model cached in the pinned base (model_path
# refuses anything else).
RUN if [ "$WORKLOAD_PROFILE" = mace-cuda ]; then \
      python3 /app/mace_inference.py --build-references; \
    elif [ "$WORKLOAD_PROFILE" = voice ]; then \
      python3 /app/voice_session.py --build-reference; fi

CMD ["python3", "/app/deployment.py"]
