    "test:generated-python-sdk": "PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=python/generated ${PYTHON_BIN:-python3} test/integration/fixtures/generated-python-sdk-models.py",
    "test:python-sdk-extensions": "PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=python/generated:python/extensions ${PYTHON_BIN:-python3} test/integration/fixtures/qualify-python-sdk-extensions.py",
    "test:generated-python-sdk-wire": "vitest run test/integration/python-api-wire.spec.ts --maxWorkers=1 -t 'qualifies the generated Python client'",
