                  "propertyName": "code",
                  "mapping": {
                    "WORKLOAD_FORBIDDEN": "#/components/schemas/WorkloadForbiddenApiError"
                  }
                }
              }
            }
          }
        },
        "404": {
          "content": {
            "application/json": {
              "schema": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/WorkloadNotFoundApiError"
