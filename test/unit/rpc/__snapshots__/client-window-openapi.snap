              "type": "string"
            },
            "agent": {
              "type": "string"
            },
            "sessionLabel": {
              "type": "string"
            },
            "nodes": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "exclusiveMinimum": 0
            },
            "gpusPerNode": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "exclusiveMinimum": 0
            },
            "launch": {
              "enum": [
                "single",
                "distributed"
              ],
              "type": "string"
            },
            "mounts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "pattern": "^(state|\\/.*)$"
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^\\/"
                  },
                  "ro": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "name",
                  "path"
                ],
                "additionalProperties": false
              }
            },
            "timeLimit": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "exclusiveMinimum": 0
            },
            "resumable": {
              "type": "boolean"
            }
          },
          "required": [
            "image",
            "cloudConfig"
          ],
          "additionalProperties": false
        }
      ]
    },
    "#/components/schemas/SecretName": {
